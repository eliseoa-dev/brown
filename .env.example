# Anthropic API key for the colony intelligence (Intelligence tab).
# Copy this file to .env and paste your key. The key is read at build/dev
# time by Vite and exposed to the browser as import.meta.env.VITE_ANTHROPIC_API_KEY.
#
# NOTE: this calls the Anthropic API directly from the browser using
# anthropic-dangerous-direct-browser-access. That exposes the key to anyone
# who opens the page — fine for a local portfolio demo, NOT for production.
VITE_ANTHROPIC_API_KEY=your_key_here
